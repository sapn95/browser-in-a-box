{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Auto-merge low-risk updates (digests, pins, minor, patch)",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Keep the pinned kasmweb/chrome tag in cib.py up to date",
      "customType": "regex",
      "managerFilePatterns": [
        "/^cib\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nDEFAULT_IMAGE = \"docker\\.io/kasmweb/chrome:(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Keep the pinned tart-guest-agent version in the packer template up to date",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packer/chrome-vm\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "github-actions": {
    "enabled": true
  }
}
